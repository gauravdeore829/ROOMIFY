datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}



model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                String               @default("USER")
  phone               String?
  isSuspended         Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  profile             UserProfile?
  properties          Property[]           @relation("OwnerProperties")
  reviews             Review[]
  applications        Application[]
  favorites           Favorite[]
  notifications       Notification[]
  reports             Report[]
  verificationRequest OwnerVerification?
  inquiries           Inquiry[]
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeOrOffice   String?
  preferredLocation String?
  budget            Float?
  roomType          String?
  facilities        String   @default("")
}

model OwnerVerification {
  id             String             @id @default(uuid())
  ownerId        String             @unique
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phone          String
  idProofRef     String
  propertyDocRef String
  address        String
  status         String             @default("PENDING")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Property {
  id           String             @id @default(uuid())
  ownerId      String
  owner        User               @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String
  address      String
  city         String
  area         String
  pincode      String
  latitude     Float
  longitude    Float
  propertyType String
  isVerified   Boolean            @default(false)
  status       String             @default("PENDING")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  rooms     Room[]
  amenities Amenity?
  rules     HouseRules?
  images    PropertyImage[]
  reviews   Review[]
  favorites Favorite[]
  reports   Report[]
  inquiries Inquiry[]

  @@index([city])
  @@index([area])
}

model Room {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType        String
  totalBeds       Int
  occupiedBeds    Int
  availableBeds   Int
  rent            Float
  securityDeposit Float
  status          String   @default("AVAILABLE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications Application[]

  @@index([rent])
}

model Amenity {
  id               String   @id @default(uuid())
  propertyId       String   @unique
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  wifi             Boolean  @default(false)
  parking          Boolean  @default(false)
  ac               Boolean  @default(false)
  food             Boolean  @default(false)
  kitchen          Boolean  @default(false)
  washingMachine   Boolean  @default(false)
  attachedBathroom Boolean  @default(false)
  powerBackup      Boolean  @default(false)
  furnished        Boolean  @default(false)
  cctv             Boolean  @default(false)
  waterSupply      Boolean  @default(false)
}

model HouseRules {
  id              String   @id @default(uuid())
  propertyId      String   @unique
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitorsAllowed Boolean  @default(false)
  smokingAllowed  Boolean  @default(false)
  petsAllowed     Boolean  @default(false)
  cookingAllowed  Boolean  @default(false)
  curfewTime      String?
  otherRules      String?
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  publicId   String?
}

model Review {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cleanliness   Int
  location      Int
  safety        Int
  ownerBehavior Int
  facilities    Int
  valueForMoney Int
  averageRating Float
  comment       String
  createdAt     DateTime @default(now())
}

model Application {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message   String?
  status    String            @default("PENDING")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String
  description String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model Inquiry {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String
  message    String
  createdAt  DateTime @default(now())
}

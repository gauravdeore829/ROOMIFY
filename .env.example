# ===============================================
# RoomEase Environment Configuration Blueprint
# ===============================================
# Copy this file to .env in backend/ and configure your credentials.

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roomease?schema=public"

# Node Backend Port & JWT
PORT=5000
JWT_SECRET="roomease_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"

# Cloudinary / External Storage Credentials (Optional - Local storage used if missing)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Python AI Microservice URL
AI_SERVICE_URL="http://localhost:8000"

# Frontend Configuration (for Vite)
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_AI_SERVICE_URL="http://localhost:8000"
